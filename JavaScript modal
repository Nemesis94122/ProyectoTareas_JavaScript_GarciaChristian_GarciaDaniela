class TodoApp extends HTMLElement {
  constructor() {
    super();
    this.attachShadow({ mode: 'open' });

    // Estado inicial de la aplicación
    this.state = {
      todos: this.loadFromStorage(),
      filter: 'all', 
      searchQuery: '',
      apiTodos: [] 
    };
  }

  connectedCallback() {
    this.renderInitialStructure();
    this.setupEventListeners();
    this.renderTodoList();
  }

addTodo(title) {
    const newTodo = {
      id: this.generateId(),
      title: title,
      date: new Date().toLocaleDateString(),
      completed: false,
      isImported: false
    };
    this.state.todos.push(newTodo);
    this.saveToStorage();
    this.renderTodoList();
  }

  updateTodo(id, updatedTitle) {
    const todo = this.state.todos.find(t => t.id === id);
    if (todo && !todo.isImported) { 
      todo.title = updatedTitle;
      this.saveToStorage();
      this.renderTodoList();
    }
  }

  deleteTodo(id) {
    this.state.todos = this.state.todos.filter(t => t.id !== id);
    this.saveToStorage();
    this.renderTodoList();
  }

  toggleTodo(id) {
    const todo = this.state.todos.find(t => t.id === id);
    if (todo) {
      todo.completed = !todo.completed;
      this.saveToStorage();
      this.renderTodoList();
    }
  }

  markAllAsCompleted() {
    this.state.todos.forEach(t => t.completed = true);
    this.saveToStorage();
    this.renderTodoList();
  }

  clearAll() {
    this.state.todos = [];
    this.saveToStorage();
    this.renderTodoList();
  }

 async fetchApiTodos() {
    const container = this.shadowRoot.getElementById('apiTasksContainer');
    container.innerHTML = '<p>Cargando tareas de la API...</p>';
    try {
      const response = await fetch('https://jsonplaceholder.typicode.com/todos');
      const data = await response.json();
      this.state.apiTodos = data.slice(0, 10); 
      this.renderImportModalList();
    } catch (error) {
      container.innerHTML = '<p style="color:red;">Error al conectar con la API.</p>';
      console.error("Error cargando la API:", error);
    }
  }

  importSelectedTodos() {
    const checkboxes = this.shadowRoot.querySelectorAll('.import-checkbox:checked');
    checkboxes.forEach(cb => {
      const todoId = parseInt(cb.value);
      const apiTodo = this.state.apiTodos.find(t => t.id === todoId);
      if (apiTodo) {
        this.state.todos.push({
          id: this.generateId(), 
          title: apiTodo.title,
          date: new Date().toLocaleDateString(),
          completed: apiTodo.completed,
          isImported: true 
        });
      }
    });
    this.saveToStorage();
    this.closeModal('importModal');
    this.renderTodoList();
  }

  openTaskModal(todoId = null) {
    const modal = this.shadowRoot.getElementById('taskModal');
    const titleInput = this.shadowRoot.getElementById('modalTaskTitle');
    const idInput = this.shadowRoot.getElementById('modalTaskId');
    const modalTitle = this.shadowRoot.getElementById('modalTitleText');

    if (todoId) {
      const todo = this.state.todos.find(t => t.id === todoId);
      if (todo.isImported) return; 
      modalTitle.innerText = 'Editar Tarea';
      idInput.value = todo.id;
      titleInput.value = todo.title;
    } else {
      modalTitle.innerText = 'Nueva Tarea';
      idInput.value = '';
      titleInput.value = '';
    }
    modal.style.display = 'flex';
  }

  closeModal(modalId) {
    this.shadowRoot.getElementById(modalId).style.display = 'none';
  }

  setupEventListeners() {
    this.shadowRoot.addEventListener('click', (e) => {
      const target = e.target;

      if (target.id === 'btnCreate') this.openTaskModal();
      if (target.id === 'btnMarkAll') this.markAllAsCompleted();
      if (target.id === 'btnClearAll') this.clearAll();
      if (target.id === 'btnImportOpen') {
        this.shadowRoot.getElementById('importModal').style.display = 'flex';
        this.fetchApiTodos();
      }
      
      if (target.classList.contains('close-modal')) {
        this.closeModal(target.closest('.modal').id);
      }

      const btnDelete = target.closest('.btn-delete');
      if (btnDelete) this.deleteTodo(btnDelete.dataset.id);

      const btnEdit = target.closest('.btn-edit');
      if (btnEdit) this.openTaskModal(btnEdit.dataset.id);
    });

    this.shadowRoot.addEventListener('change', (e) => {
      if (e.target.classList.contains('todo-check')) {
        this.toggleTodo(e.target.dataset.id);
      }
    });

    this.shadowRoot.getElementById('taskForm').addEventListener('submit', (e) => {
      e.preventDefault();
      const id = this.shadowRoot.getElementById('modalTaskId').value;
      const title = this.shadowRoot.getElementById('modalTaskTitle').value;

      if (id) {
        this.updateTodo(id, title);
      } else {
        this.addTodo(title);
      }
      this.closeModal('taskModal');
    });

    this.shadowRoot.getElementById('btnConfirmImport').addEventListener('click', () => {
      this.importSelectedTodos();
    });

    this.shadowRoot.getElementById('filterSelect').addEventListener('change', (e) => {
      this.state.filter = e.target.value;
      this.renderTodoList();
    });

    this.shadowRoot.getElementById('searchInput').addEventListener('input', (e) => {
      this.state.searchQuery = e.target.value.toLowerCase();
      this.renderTodoList();
    });
  }
}
